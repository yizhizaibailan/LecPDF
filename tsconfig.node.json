{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "electron.vite.config.test.ts",
    "vitest.config.ts",
    "electron/main/**/*.ts",
    "electron/preload/**/*.ts",
    "electron/shared/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts"
  ]
}
